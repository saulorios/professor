# Copie este arquivo para .env e preencha.
# O .env não vai para o git (está no .gitignore) e é lido pelo servidor.py.
# Variáveis já definidas no ambiente têm prioridade sobre o que estiver aqui.

# Qual IA responde: anthropic, openrouter ou openai.
# Sem esta linha, vale "openrouter" se houver OPENROUTER_API_KEY, senão "anthropic".
LOUSA_PROVEDOR=openrouter

# --- openrouter (tem modelos gratuitos, terminados em ":free") ---
# Chave em https://openrouter.ai/keys ; lista em https://openrouter.ai/models?q=free
OPENROUTER_API_KEY=sk-or-v1-...
LOUSA_MODELO=nvidia/nemotron-3-ultra-550b-a55b:free

# --- anthropic (paga) ---
# LOUSA_PROVEDOR=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LOUSA_MODELO=claude-sonnet-5

# --- openai: qualquer endpoint no formato OpenAI ---
# Ollama local (sem chave):
# LOUSA_PROVEDOR=openai
# LOUSA_URL=http://127.0.0.1:11434/v1/chat/completions
# LOUSA_MODELO=llama3.1
# Groq, DeepSeek, Together e afins: a mesma coisa, com LOUSA_CHAVE.
# LOUSA_CHAVE=...

# Opcionais
# LOUSA_MAX_TOKENS=4000
# LOUSA_TEMPO_LIMITE=300
