/* ==========================================================================
   Tema escuro inspirado no Antigravity IDE / VS Code
   ========================================================================== */

/* Janela principal e body: mesma cor de fundo da topbar */
QMainWindow,
#Body {
    background-color: #1F1F1F;
}

/* Topbar: mesmo fundo do body, separada apenas por uma linha de 1px */
TitleBar {
    background-color: #1F1F1F;
    border: none;
    border-bottom: 1px solid #2B2B2B;
}

/* Logo (placeholder 16x16) */
#Logo {
    background-color: #0078D4;
    border-radius: 3px;
}

/* Título centralizado */
#TitleLabel {
    background: transparent;
    color: #CCCCCC;
    font-size: 13px;
}

/* Menu embutido na topbar */
QMenuBar {
    background: transparent;
    border: none;
    padding: 0px;
    spacing: 0px;
    color: #CCCCCC;
    font-size: 13px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 8px;
    border-radius: 4px;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
    background-color: #2A2D2E;
}

/* Botões minimizar / maximizar / fechar
   (as cores do ícone são propriedades do TitleBarButton) */
TitleBarButton {
    background: transparent;
    border: none;
    qproperty-iconColor: #CCCCCC;
    qproperty-iconHoverColor: #CCCCCC;
}

TitleBarButton:hover {
    background-color: #2A2D2E;
}

/* Fechar: hover vermelho com ícone branco */
TitleBarButton#CloseButton {
    qproperty-iconHoverColor: #FFFFFF;
}

TitleBarButton#CloseButton:hover {
    background-color: #E81123;
}

/* Menus abertos a partir da topbar */
QMenu {
    background-color: #1F1F1F;
    border: 1px solid #454545;
    padding: 4px;
    color: #CCCCCC;
    font-size: 13px;
}

QMenu::item {
    padding: 4px 24px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #04395E;
}

/* Barra inferior do player: mesmo fundo, separada por uma linha de 1px */
PlayerBar {
    background-color: #1F1F1F;
    border: none;
    border-top: 1px solid #2B2B2B;
}

PlayerBar QPushButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 3px 10px;
    color: #CCCCCC;
    font-size: 12px;
}

PlayerBar QPushButton:hover {
    background-color: #2A2D2E;
}

PlayerBar QPushButton:checked {
    background-color: #37373D;
    color: #FFFFFF;
}

PlayerBar QPushButton:disabled {
    color: #6B6B6B;
}

PlayerBar QLabel {
    color: #9D9D9D;
    font-size: 12px;
}

/* Barra de perguntas à IA, acima da barra do player */
AskBar {
    background-color: #1F1F1F;
    border: none;
    border-top: 1px solid #2B2B2B;
}

#AskField {
    background-color: #252526;
    border: 1px solid #2B2B2B;
    border-radius: 6px;
    padding: 5px 10px;
    color: #CCCCCC;
    font-size: 13px;
    selection-background-color: #04395E;
}

#AskField:focus {
    border: 1px solid #0078D4;
}

AskBar QPushButton {
    background: transparent;
    border: 1px solid #2B2B2B;
    border-radius: 6px;
    padding: 5px 12px;
    color: #CCCCCC;
    font-size: 12px;
}

AskBar QPushButton:hover {
    background-color: #2A2D2E;
}

AskBar QPushButton:checked {
    background-color: #37373D;
    color: #FFFFFF;
}

AskBar QPushButton:disabled {
    color: #6B6B6B;
    border-color: #252526;
}

AskBar QPushButton#AskButton {
    background-color: #0078D4;
    border-color: #0078D4;
    color: #FFFFFF;
}

AskBar QPushButton#AskButton:hover {
    background-color: #1A86D9;
}

AskBar QPushButton#AskButton:disabled {
    background-color: #252526;
    border-color: #2B2B2B;
    color: #6B6B6B;
}

#AskStatus {
    background: transparent;
    color: #9D9D9D;
    font-size: 11px;
}

/* Log dos comandos recebidos (recolhível) */
#LessonLog {
    background-color: #252526;
    border: none;
    border-top: 1px solid #2B2B2B;
    color: #9D9D9D;
    font-family: "Ubuntu Mono", "Cascadia Mono", monospace;
    font-size: 12px;
}

/* Legenda da "fala": faixa semitransparente na parte inferior da lousa */
#Caption {
    background-color: rgba(0, 0, 0, 150);
    color: #CCCCCC;
    font-size: 16px;
    padding: 8px 24px;
}

/* Painel de ajuste (F10), encostado à direita da lousa */
TuningPanel {
    background-color: #252526;
    border: none;
    border-left: 1px solid #2B2B2B;
}

TuningPanel QScrollArea,
TuningPanel #TuningContent {
    background-color: #252526;
    border: none;
}

TuningPanel QLabel {
    background: transparent;
    color: #CCCCCC;
    font-size: 12px;
}

TuningPanel QLabel#TuningTitle {
    font-size: 13px;
    font-weight: bold;
}

TuningPanel QLabel#TuningSection {
    font-weight: bold;
    padding-top: 10px;
    padding-bottom: 2px;
    border-bottom: 1px solid #2B2B2B;
}

TuningPanel QSlider::groove:horizontal {
    height: 4px;
    background: #2B2B2B;
    border-radius: 2px;
}

TuningPanel QSlider::handle:horizontal {
    width: 10px;
    margin: -3px 0;
    border-radius: 5px;
    background: #CCCCCC;
}

TuningPanel QSlider::handle:horizontal:disabled {
    background: #6B6B6B;
}

TuningPanel QPushButton {
    background: transparent;
    border: 1px solid #2B2B2B;
    border-radius: 4px;
    padding: 4px 8px;
    color: #CCCCCC;
    font-size: 12px;
}

TuningPanel QPushButton:hover {
    background-color: #2A2D2E;
}

TuningPanel QScrollBar:vertical {
    background: #252526;
    width: 10px;
    margin: 0;
}

TuningPanel QScrollBar::handle:vertical {
    background: rgba(204, 204, 204, 60);
    border-radius: 3px;
    min-height: 30px;
    margin: 2px;
}

TuningPanel QScrollBar::add-line:vertical,
TuningPanel QScrollBar::sub-line:vertical {
    height: 0;
}

TuningPanel QScrollBar::add-page:vertical,
TuningPanel QScrollBar::sub-page:vertical {
    background: none;
}
