/* ==========================================================================
   Tema escuro inspirado no Antigravity IDE / VS Code
   ========================================================================== */

/* Janela principal e body: mesma cor de fundo da topbar */
QMainWindow,
#Body {
    background-color: #1F1F1F;
}

/* Topbar: mesmo fundo do body, separada apenas por uma linha de 1px */
TitleBar {
    background-color: #1F1F1F;
    border: none;
    border-bottom: 1px solid #2B2B2B;
}

/* Logo (placeholder 16x16) */
#Logo {
    background-color: #0078D4;
    border-radius: 3px;
}

/* Título centralizado */
#TitleLabel {
    background: transparent;
    color: #CCCCCC;
    font-size: 13px;
}

/* Menu embutido na topbar */
QMenuBar {
    background: transparent;
    border: none;
    padding: 0px;
    spacing: 0px;
    color: #CCCCCC;
    font-size: 13px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 8px;
    border-radius: 4px;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
    background-color: #2A2D2E;
}

/* Botões minimizar / maximizar / fechar
   (as cores do ícone são propriedades do TitleBarButton) */
TitleBarButton {
    background: transparent;
    border: none;
    qproperty-iconColor: #4F4F4F;
    qproperty-iconHoverColor: #858585;
    qproperty-hoverColor: #2A2A2A;   /* círculo de hover, igual nos três botões */
}

/* Menus abertos a partir da topbar */
QMenu {
    background-color: #1F1F1F;
    border: 1px solid #454545;
    padding: 4px;
    color: #CCCCCC;
    font-size: 13px;
}

QMenu::item {
    padding: 4px 24px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #04395E;
}

/* Barra inferior do player: mesmo fundo, separada por uma linha de 1px */
PlayerBar {
    background-color: #1F1F1F;
    border: none;
    border-top: 1px solid #2B2B2B;
}

PlayerBar QPushButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 3px 10px;
    color: #CCCCCC;
    font-size: 12px;
}

PlayerBar QPushButton:hover {
    background-color: #2A2D2E;
}

PlayerBar QPushButton:checked {
    background-color: #37373D;
    color: #FFFFFF;
}

PlayerBar QPushButton:disabled {
    color: #6B6B6B;
}

PlayerBar QLabel {
    color: #9D9D9D;
    font-size: 12px;
}

/* Painel do professor (F8), à direita da lousa */
AgentPanel {
    background-color: #1F1F1F;
    border: none;
    border-left: 1px solid #2B2B2B;
}

#BodySplitter::handle {
    background-color: #2B2B2B;
}

#AgentHeader {
    background-color: #1F1F1F;
    border-bottom: 1px solid #2B2B2B;
}

#AgentTitle {
    background: transparent;
    color: #CCCCCC;
    font-size: 13px;
}

#AgentIcon {
    background: transparent;
    border: none;
    border-radius: 4px;
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    color: #CCCCCC;
    font-size: 13px;
}

#AgentIcon:hover {
    background-color: #2A2D2E;
}

#AgentTimeline,
#AgentTimelineContent {
    background-color: #1F1F1F;
    border: none;
}

#AgentTimeline QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

#AgentTimeline QScrollBar::handle:vertical {
    background: rgba(204, 204, 204, 55);
    border-radius: 3px;
    min-height: 30px;
    margin: 2px;
}

#AgentTimeline QScrollBar::add-line:vertical,
#AgentTimeline QScrollBar::sub-line:vertical {
    height: 0;
}

#AgentTimeline QScrollBar::add-page:vertical,
#AgentTimeline QScrollBar::sub-page:vertical {
    background: none;
}

/* Cartão de uma pergunta na timeline */
#TimelineCard {
    background-color: #252526;
    border: 1px solid #2B2B2B;
    border-radius: 6px;
}

#TimelineCard:hover {
    border-color: #37373D;
}

#TimelineCard[atual="true"] {
    background-color: #2A2D2E;
    border-color: #0078D4;
}

#CardQuestion {
    background: transparent;
    color: #CCCCCC;
    font-size: 12px;
}

#CardSummary {
    background: transparent;
    color: #8A8A8A;
    font-size: 11px;
}

#AgentFooter {
    background-color: #1F1F1F;
    border-top: 1px solid #2B2B2B;
}

#AgentInput {
    background-color: #252526;
    border: 1px solid #2B2B2B;
    border-radius: 6px;
    padding: 4px 8px;
    color: #CCCCCC;
    font-size: 13px;
    selection-background-color: #04395E;
}

#AgentInput:focus {
    border: 1px solid #0078D4;
}

#AgentSend {
    background-color: #0078D4;
    border: none;
    border-radius: 6px;
    min-width: 30px;
    max-width: 30px;
    min-height: 30px;
    color: #FFFFFF;
    font-size: 13px;
}

#AgentSend:hover {
    background-color: #1A86D9;
}

#AgentSend:disabled {
    background-color: #252526;
    color: #6B6B6B;
}

AgentPanel QPushButton {
    background: transparent;
    border: 1px solid #2B2B2B;
    border-radius: 6px;
    padding: 4px 10px;
    color: #CCCCCC;
    font-size: 12px;
}

AgentPanel QPushButton:hover {
    background-color: #2A2D2E;
}

AgentPanel QPushButton:checked {
    background-color: #37373D;
    color: #FFFFFF;
}

AgentPanel QPushButton:disabled {
    color: #6B6B6B;
    border-color: #252526;
}

#AgentStatus {
    background: transparent;
    color: #9D9D9D;
    font-size: 11px;
}

#AgentDisclaimer {
    background: transparent;
    color: #6B6B6B;
    font-size: 10px;
}

/* Editor da aula (F9) */
LessonEditor {
    background-color: #1F1F1F;
    border: none;
    border-top: 1px solid #2B2B2B;
}

#LessonText {
    background-color: #252526;
    border: 1px solid #2B2B2B;
    border-radius: 6px;
    padding: 4px 6px;
    color: #CCCCCC;
    font-family: "Ubuntu Mono", "Cascadia Mono", monospace;
    font-size: 12px;
    selection-background-color: #04395E;
}

LessonEditor QPushButton {
    background: transparent;
    border: 1px solid #2B2B2B;
    border-radius: 6px;
    padding: 5px 12px;
    color: #CCCCCC;
    font-size: 12px;
}

LessonEditor QPushButton:hover {
    background-color: #2A2D2E;
}

LessonEditor QPushButton#AskButton {
    background-color: #0078D4;
    border-color: #0078D4;
    color: #FFFFFF;
}

LessonEditor QPushButton#AskButton:hover {
    background-color: #1A86D9;
}

#LessonStatus {
    background: transparent;
    color: #9D9D9D;
    font-size: 11px;
}

#LessonStatus[erro="true"] {
    color: #F48771;
}

/* Barra de rolagem da lousa: fina e discreta, encostada na direita */
#BoardScroll {
    background: transparent;
    width: 8px;
    margin: 0;
}

#BoardScroll::handle:vertical {
    background: rgba(204, 204, 204, 55);
    border-radius: 3px;
    min-height: 40px;
    margin: 2px;
}

#BoardScroll::handle:vertical:hover {
    background: rgba(204, 204, 204, 110);
}

#BoardScroll::add-line:vertical,
#BoardScroll::sub-line:vertical {
    height: 0;
}

#BoardScroll::add-page:vertical,
#BoardScroll::sub-page:vertical {
    background: none;
}

/* Em que parte da lousa estamos ("2/3") */
#PositionBadge {
    background-color: rgba(0, 0, 0, 120);
    border-radius: 4px;
    padding: 2px 7px;
    color: #9D9D9D;
    font-size: 11px;
}

/* Aviso clicável: a escrita continua fora da vista */
#BelowNotice {
    background-color: rgba(0, 0, 0, 160);
    border: 1px solid #2B2B2B;
    border-radius: 12px;
    padding: 4px 12px;
    color: #CCCCCC;
    font-size: 12px;
}

#BelowNotice:hover {
    background-color: #04395E;
    border-color: #0078D4;
    color: #FFFFFF;
}

/* Indicador de gravação, no canto da lousa */
#RecordingBadge {
    background-color: rgba(0, 0, 0, 140);
    border-radius: 4px;
    padding: 3px 8px;
    color: #F48771;
    font-size: 12px;
}

/* Legenda da "fala": faixa semitransparente na parte inferior da lousa */
#Caption {
    background-color: rgba(0, 0, 0, 150);
    color: #CCCCCC;
    font-size: 16px;
    padding: 8px 24px;
}

/* Painel de ajuste (F10), encostado à direita da lousa */
TuningPanel {
    background-color: #252526;
    border: none;
    border-left: 1px solid #2B2B2B;
}

TuningPanel QScrollArea,
TuningPanel #TuningContent {
    background-color: #252526;
    border: none;
}

TuningPanel QLabel {
    background: transparent;
    color: #CCCCCC;
    font-size: 12px;
}

TuningPanel QLabel#TuningTitle {
    font-size: 13px;
    font-weight: bold;
}

TuningPanel QLabel#TuningSection {
    font-weight: bold;
    padding-top: 10px;
    padding-bottom: 2px;
    border-bottom: 1px solid #2B2B2B;
}

TuningPanel QSlider::groove:horizontal {
    height: 4px;
    background: #2B2B2B;
    border-radius: 2px;
}

TuningPanel QSlider::handle:horizontal {
    width: 10px;
    margin: -3px 0;
    border-radius: 5px;
    background: #CCCCCC;
}

TuningPanel QSlider::handle:horizontal:disabled {
    background: #6B6B6B;
}

TuningPanel QPushButton {
    background: transparent;
    border: 1px solid #2B2B2B;
    border-radius: 4px;
    padding: 4px 8px;
    color: #CCCCCC;
    font-size: 12px;
}

TuningPanel QPushButton:hover {
    background-color: #2A2D2E;
}

TuningPanel QScrollBar:vertical {
    background: #252526;
    width: 10px;
    margin: 0;
}

TuningPanel QScrollBar::handle:vertical {
    background: rgba(204, 204, 204, 60);
    border-radius: 3px;
    min-height: 30px;
    margin: 2px;
}

TuningPanel QScrollBar::add-line:vertical,
TuningPanel QScrollBar::sub-line:vertical {
    height: 0;
}

TuningPanel QScrollBar::add-page:vertical,
TuningPanel QScrollBar::sub-page:vertical {
    background: none;
}
